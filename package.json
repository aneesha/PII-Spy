{
  "name": "pii-spy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private, local pre-paste PII detection for Chrome.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:model": "node scripts/download-model.js",
    "build": "node scripts/build.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test tests/browser/*.test.js",
    "check:dependencies": "node scripts/check-dependencies.js",
    "test:extension": "node tests/browser/extension-smoke.js"
  },
  "dependencies": {
    "@picocss/pico": "2.1.1",
    "@xenova/transformers": "2.17.2",
    "gliner": "0.0.19",
    "onnxruntime-web": "1.19.2"
  },
  "devDependencies": {
    "esbuild": "0.25.11",
    "jsdom": "26.1.0",
    "playwright": "1.56.1"
  },
  "overrides": {
    "onnxruntime-web": "1.19.2",
    "onnxruntime-common": "1.19.2"
  }
}
